<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.marcablanca.platform</groupId>
        <artifactId>marca-blanca-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>consola-infrastructure</artifactId>
    <packaging>jar</packaging>

    <properties>
        <jjwt.version>0.13.0</jjwt.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.marcablanca.platform</groupId>
            <artifactId>consola-application</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.marcablanca.platform</groupId>
            <artifactId>consola-domain</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- ACL hacia aprovisionamiento (dueno del agregado Empresa). Solo lo usa
             el puente en consola.infrastructure; el nucleo de consola no lo ve. -->
        <dependency>
            <groupId>com.marcablanca.platform</groupId>
            <artifactId>aprovisionamiento-application</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.marcablanca.platform</groupId>
            <artifactId>aprovisionamiento-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.marcablanca.platform</groupId>
            <artifactId>correo-application</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.marcablanca.platform</groupId>
            <artifactId>correo-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.marcablanca.platform</groupId>
            <artifactId>modulos-empresa-application</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.marcablanca.platform</groupId>
            <artifactId>modulos-empresa-domain</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Para exponer el on/off de IA y la rotacion del webhook de Liwa a la
             consola (super admin): se corre ConfigurarOmnicanal con
             ContextoEmpresaActual apuntando a la empresa objetivo, igual que
             hace el propio tenant en su self-service. -->
        <dependency>
            <groupId>com.marcablanca.platform</groupId>
            <artifactId>omnicanal-application</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.marcablanca.platform</groupId>
            <artifactId>empresas-application</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
